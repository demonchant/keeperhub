# Demo mode provides a deterministic local simulation and never broadcasts.
GRANTRAIL_MODE=demo

# Required for all mutating API calls outside demo mode. Generate at least 32 random bytes.
GRANTRAIL_ADMIN_TOKEN=replace-with-at-least-32-random-characters
GRANTRAIL_ALLOWED_ORIGIN=http://localhost:3000

# Persistent libSQL/SQLite database. Local file works out of the box.
DATABASE_URL=file:./data/grantrail.db
DATABASE_AUTH_TOKEN=

# Karma GAP v2 public indexer.
KARMA_API_BASE_URL=https://gapapi.karmahq.xyz
KARMA_PROJECT_SLUG=

# KeeperHub organization API key and hosted API.
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com/api
KEEPERHUB_API_KEY=
KEEPERHUB_WORKFLOW_ID=

# Mainnet guardrails. Optimism USDC is the only production asset allowed by default.
ALLOWED_CHAIN_IDS=10
ALLOWED_TOKEN_ADDRESSES=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85
MAX_PAYOUT_USDC=10
PUBLIC_MAX_SUPPORT_USDC=1
CONFIRMATION_TIMEOUT_MS=180000
